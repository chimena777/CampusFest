<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- CU1 · Consultar cupos. App asigna el controlador con setController. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="pantalla" spacing="12">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Consultar cupos" styleClass="titulo"/>
    <Label text="Escriba el identificador del evento (por ejemplo, ev-1)."/>
    <HBox spacing="8">
        <TextField fx:id="campoEventoId" promptText="Id del evento" onAction="#alConsultar"/>
        <Button text="Consultar" defaultButton="true" onAction="#alConsultar"/>
    </HBox>
    <Label fx:id="etiquetaMensaje" styleClass="mensaje" wrapText="true"/>
</VBox>